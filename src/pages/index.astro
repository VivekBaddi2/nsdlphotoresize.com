---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="min-h-screen bg-white text-ink">
		<header class="border-b border-hairline">
			<nav
				class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
				aria-label="Main navigation"
			>
				<a
					class="flex items-center gap-2.5 font-semibold tracking-tight"
					href="/"
					aria-label="NSDL Photo Resize home"
				>
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<path
								d="M7.25 3.75h6.5l4.5 4.5v11.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5V4.25a.5.5 0 0 1 .5-.5Z"
								stroke="currentColor"
								stroke-width="1.5"></path>
							<path
								d="M13.5 4v4.5H18M9.5 13h6m-6 3h6"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"></path>
						</svg>
					</span>
					<span>NSDL Photo Resize</span>
				</a>
				<div
					class="hidden items-center gap-7 text-sm text-body md:flex"
				>
					<a class="transition hover:text-ink" href="#how-it-works"
						>How it works</a
					>
					<a class="transition hover:text-ink" href="#requirements"
						>Requirements</a
					>
					<a class="transition hover:text-ink" href="#faq">FAQ</a>
				</div>
				<a class="button-primary h-10! px-4!" href="#photo-tool"
					>Resize a photo</a
				>
			</nav>
		</header>

		<main>
			<section
				class="hero-wash px-5 pb-12 pt-16 sm:px-8 sm:pb-16 sm:pt-20"
			>
				<div
					class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:gap-16"
				>
					<div class="max-w-xl">
						<p class="eyebrow mb-2 sm:mb-5">
							PAN photo &amp; signature tool
						</p>
						<h1
							class="max-w-xl text-[2.6rem] font-semibold leading-[1.05] tracking-[-0.055em] lg:text-5xl"
						>
							PAN card photo resizer, ready when you are.
						</h1>
						<p
							class="mt-5 max-w-lg text-base leading-7 text-body sm:text-lg"
						>
							Crop your photo or signature to PAN dimensions and
							download a clean JPEG right in your browser.
						</p>
						<div class="mt-7 flex flex-wrap items-center gap-3">
							<a class="button-primary" href="#photo-tool">
								Start resizing
								<svg
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
								>
									<path
										d="M4.5 10h11m-4.5-4.5L15.5 10 11 14.5"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</a>
						</div>
						<div
							class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm text-body"
						>
							<span class="inline-flex items-center gap-2">
								<svg
									class="h-5 w-5 shrink-0 text-success"
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
									><path
										d="m4.5 10.5 3.5 3 7.5-8"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
								No account needed
							</span>
							<span class="inline-flex items-center gap-2">
								<svg
									class="h-5 w-5 shrink-0 text-success"
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
									><path
										d="m4.5 10.5 3.5 3 7.5-8"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
								Photo and signature modes
							</span>
							<span class="inline-flex items-center gap-2">
								<svg
									class="h-5 w-5 shrink-0 text-success"
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
									><path
										d="m4.5 10.5 3.5 3 7.5-8"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
								Files stay on your device
							</span>
						</div>
					</div>

					<section
						id="photo-tool"
						class="tool-card scroll-mt-6"
						aria-labelledby="tool-heading"
					>
						<div
							class="flex flex-wrap items-start justify-between gap-4 border-b border-hairline px-5 py-5 sm:px-7"
						>
							<div>
								<h2
									id="tool-heading"
									class="text-lg font-semibold tracking-tight"
								>
									Resize your image
								</h2>
								<p class="mt-1 text-sm text-body">
									Choose an image type to get started.
								</p>
							</div>
							<span class="badge-pill">Free · in-browser</span>
						</div>

						<div class="space-y-5 px-5 py-5 sm:px-7 sm:py-6">
							<div id="mode-controls" hidden>
								<p class="mb-2.5 text-sm font-medium">
									1. Choose image type
								</p>
								<div
									class="grid grid-cols-2 gap-2 rounded-xl bg-surface-subtle p-1"
									role="group"
									aria-label="Image type"
								>
									<button
										class="mode-button is-active"
										type="button"
										data-mode="photo"
										aria-pressed="true"
									>
										<svg
											aria-hidden="true"
											viewBox="0 0 20 20"
											fill="none"
											><circle
												cx="10"
												cy="7"
												r="3"
												stroke="currentColor"
												stroke-width="1.5"
											></circle><path
												d="M4.5 16c.4-2.5 2.3-3.8 5.5-3.8s5.1 1.3 5.5 3.8"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
											></path></svg
										>
										Photograph
									</button>
									<button
										class="mode-button"
										type="button"
										data-mode="signature"
										aria-pressed="false"
									>
										<svg
											aria-hidden="true"
											viewBox="0 0 20 20"
											fill="none"
											><path
												d="m4 13.7 8.7-8.8a1.5 1.5 0 0 1 2.1 2.2L6 15.8l-3 .8.9-2.9Z"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linejoin="round"
											></path><path
												d="M10.8 7l2.2 2.2"
												stroke="currentColor"
												stroke-width="1.5"></path></svg
										>
										Signature
									</button>
								</div>
							</div>

							<div id="drop-zone" class="drop-zone">
								<input
									id="file-input"
									class="sr-only"
									type="file"
									accept="image/jpeg,image/png,image/webp"
								/>
								<div class="drop-placeholder">
									<span
										class="upload-icon"
										aria-hidden="true"
									>
										<svg viewBox="0 0 24 24" fill="none"
											><path
												d="M12 15V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14.5v4A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-4"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path></svg
										>
									</span>
									<strong
										class="mt-3 block text-sm font-semibold"
										>Drop your image here</strong
									>
									<span class="mt-1 block text-sm text-body"
										>or choose a file from your device</span
									>
									<span
										class="mt-3 inline-flex min-h-10 items-center rounded-lg border border-hairline-strong bg-white px-4 text-sm font-medium transition hover:bg-surface-soft"
										>Choose image</span
									>
									<span class="mt-3 block text-xs text-muted"
										>JPG, PNG or WebP</span
									>
								</div>
								<div class="editor-preview" hidden>
									<div class="crop-stage">
										<canvas id="preview-canvas"></canvas>
										<div
											class="crop-selection"
											tabindex="0"
											role="group"
											aria-label="Crop selection. Use arrow keys to move it. Drag inside to reposition or drag a corner to resize."
										>
											<div
												class="crop-grid"
												aria-hidden="true"
											>
											</div>
											<span
												class="crop-handle crop-handle-nw"
												data-corner="nw"
												aria-hidden="true"></span>
											<span
												class="crop-handle crop-handle-ne"
												data-corner="ne"
												aria-hidden="true"></span>
											<span
												class="crop-handle crop-handle-sw"
												data-corner="sw"
												aria-hidden="true"></span>
											<span
												class="crop-handle crop-handle-se"
												data-corner="se"
												aria-hidden="true"></span>
										</div>
									</div>
									<div class="canvas-hint">
										Drag the box to move · drag a corner to
										resize
									</div>
								</div>
							</div>

							<div id="editor-controls" class="space-y-5" hidden>
								<div>
									<p class="text-sm leading-6 text-body">
										Drag the crop box to move it. Drag a
										corner to resize; its proportions stay
										fixed.
									</p>
								</div>

								<div class="grid gap-3 grid-cols-2">
									<label class="field-label">
										<span
											>Maximum file size <span
												class="font-normal text-muted"
												>(KB)</span
											></span
										>
										<input
											id="max-kb"
											class="form-control"
											type="number"
											value="50"
											readonly
											aria-readonly="true"
										/>
									</label>
									<label class="field-label">
										<span>Resolution (minimum 200 DPI)</span
										>
										<select id="dpi" class="form-control">
											<option value="200" selected
												>200 DPI</option
											>
											<option value="300">300 DPI</option>
											<option value="600">600 DPI</option>
										</select>
									</label>
								</div>

								<div class="grid grid-cols-2 gap-3">
									<label class="field-label">
										<span
											>Width <span
												class="font-normal text-muted"
												>(cm)</span
											></span
										>
										<input
											id="width-cm"
											class="form-control"
											type="number"
											value="2.5"
											min="0.1"
											step="0.1"
										/>
									</label>
									<label class="field-label">
										<span
											>Height <span
												class="font-normal text-muted"
												>(cm)</span
											></span
										>
										<input
											id="height-cm"
											class="form-control"
											type="number"
											value="3.5"
											min="0.1"
											step="0.1"
										/>
									</label>
								</div>
								<p
									id="capture-guidance"
									class="-mt-2 text-xs leading-5 text-body"
								>
									Use a clear, recent photograph with a plain
									white background.
								</p>

								<div
									class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-surface-soft px-4 py-3"
								>
									<div class="text-sm">
										<p
											id="output-dimensions"
											class="font-medium"
										>
											295 × 413 px
										</p>
										<p
											id="file-details"
											class="mt-0.5 text-xs text-body"
										>
											JPEG resolution metadata: 200 DPI
										</p>
									</div>
									<label class="field-label filename-field">
										<span class="sr-only"
											>Download filename</span
										>
										<input
											id="filename"
											class="filename-input"
											type="text"
											value="pan-photo.jpeg"
											aria-label="Download filename"
										/>
									</label>
								</div>

								<div class="flex flex-col gap-3 sm:flex-row">
									<button
										id="download"
										class="button-primary flex-1 justify-center disabled:cursor-not-allowed disabled:opacity-45"
										type="button"
										disabled
									>
										Download JPEG
										<svg
											aria-hidden="true"
											viewBox="0 0 20 20"
											fill="none"
											><path
												d="M10 3.5v9m0 0 3.5-3.5M10 12.5 6.5 9M4.5 14.5v1A1.5 1.5 0 0 0 6 17h8a1.5 1.5 0 0 0 1.5-1.5v-1"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path></svg
										>
									</button>
									<button
										id="remove-image"
										class="button-secondary justify-center disabled:cursor-not-allowed disabled:opacity-45"
										type="button"
										disabled>Start over</button
									>
								</div>
								<p class="text-xs leading-5 text-body">
									Default sizes: Photo 2.5 × 3.5 cm (width x height);
									Signature 4.5 × 2 cm (width x height). Adjust the width and height as
									needed. Exports are prepared at 200 DPI or
									higher and compressed to under 50 KB. Check
									your application portal’s current
									instructions if your application type
									differs.
								</p>
							</div>
						</div>
					</section>
				</div>
			</section>

			<section class="px-5 py-16 sm:px-8 sm:py-20" id="how-it-works">
				<div class="mx-auto max-w-6xl">
					<div class="max-w-xl">
						<p class="eyebrow mb-3">Three simple steps</p>
						<h2 class="section-heading">
							How to use the PAN card photo resizer
						</h2>
						<p class="mt-4 leading-7 text-body">
							Resize a photo or signature for your PAN card
							application with a quick browser-based workflow.
							Whether you searched for an NSDL photo resize or a
							UTI photo resize, use these steps to prepare and
							review your image before uploading it to the
							official portal.
						</p>
					</div>
					<ol class="mt-9 grid gap-4 md:grid-cols-3">
						<li class="step-card">
							<span class="step-number">01</span>
							<h3 class="mt-5 font-semibold">
								Select your photo or signature
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Choose a JPG, PNG, or WebP from your device,
								then select Photograph or Signature. Start
								with the preset dimensions or enter the
								values requested by your PAN application.
							</p>
						</li>
						<li class="step-card">
							<span class="step-number">02</span>
							<h3 class="mt-5 font-semibold">
								Crop and check the output
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Move the crop box to frame the image, select
								the resolution, and review its dimensions
								and file size. The JPEG export is prepared
								under 50 KB.
							</p>
						</li>
						<li class="step-card">
							<span class="step-number">03</span>
							<h3 class="mt-5 font-semibold">
								Download and verify your JPEG
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Save the resized photo or signature to your
								device. Before uploading, confirm the file
								meets the current requirements on the
								Protean or UTIITSL portal.
							</p>
						</li>
					</ol>
				</div>
			</section>

			<section
				id="requirements"
				class="border-y border-hairline bg-surface-soft px-5 py-16 sm:px-8 sm:py-20"
			>
				<div
					class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr]"
				>
					<div>
						<p class="eyebrow mb-3">Check before uploading</p>
						<h2 class="section-heading">
							PAN card photo and signature size requirements
						</h2>
						<p class="mt-4 leading-7 text-body">
							Use this PAN card document resizer online to prepare
							a photo or signature JPEG under 50 KB. The default
							photo size is 2.5 × 3.5 cm and the signature size is
							4.5 × 2 cm, with resolution settings starting at
							200 DPI. These are editable defaults, not a
							guarantee of acceptance: image dimensions, file
							size, format, and resolution can vary by application.
							Check the latest instructions from the service you
							are using before you upload.
						</p>
						<div class="mt-5 flex flex-wrap gap-3">
							<a
								class="text-link"
								href="https://tinpan.proteantech.in/"
								target="_blank"
								rel="noreferrer"
								>Protean PAN portal <span aria-hidden="true"
									>↗</span
								></a
							>
							<a
								class="text-link"
								href="https://www.utiitsl.com/"
								target="_blank"
								rel="noreferrer"
								>UTIITSL website <span aria-hidden="true"
									>↗</span
								></a
							>
						</div>
					</div>
					<div class="grid gap-3 sm:grid-cols-2">
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M5 6.5h14A1.5 1.5 0 0 1 20.5 8v9a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 17V8A1.5 1.5 0 0 1 5 6.5Z"
										stroke="currentColor"
										stroke-width="1.5"></path><circle
										cx="9"
										cy="11"
										r="1.5"
										stroke="currentColor"
										stroke-width="1.5"></circle><path
										d="m4 17 4.2-3.5a1 1 0 0 1 1.3 0l2 1.7 2.7-2.3a1 1 0 0 1 1.3 0L20 16.5"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Start with a clear source image
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								For a PAN card photo, use a recent, sharp, and
								well-lit image. For a signature, use a clear
								scan or photo on plain paper. Avoid blur,
								shadows, filters, and glare.
							</p>
						</article>
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M4 7.5h16M4 12h16M4 16.5h10"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path><circle
										cx="18"
										cy="16.5"
										r="2"
										stroke="currentColor"
										stroke-width="1.5"></circle></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Confirm dimensions and KB limits
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								The presets are 2.5 × 3.5 cm for a photo and
								4.5 × 2 cm for a signature. The tool compresses
								each JPEG under 50 KB; compare dimensions,
								resolution, and file limits with the current
								portal instructions.
							</p>
						</article>
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M7 4h7l4 4v12H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"
										stroke="currentColor"
										stroke-width="1.5"></path><path
										d="M14 4v5h5M9 14h6m-6 3h6"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Review the saved image
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Open the downloaded JPEG and check that the
								crop, orientation, and visible details are
								correct. Your original image remains unchanged
								if you need to adjust and export again.
							</p>
						</article>
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M12 3.5 5 6v5.5c0 4.2 2.7 7.5 7 9 4.3-1.5 7-4.8 7-9V6l-7-2.5Z"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"></path><path
										d="m9 12 2 2 4-4"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Resize privately in your browser
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Photo selection, preview, and export happen in
								your browser. Images are not uploaded to this
								website; submit them only through the official
								PAN application portal.
							</p>
						</article>
					</div>
				</div>
			</section>

			<section id="faq" class="px-5 py-16 sm:px-8 sm:py-20">
				<div class="mx-auto max-w-3xl">
					<p class="eyebrow mb-3 text-center">Good to know</p>
					<h2 class="section-heading text-center">
						Frequently asked questions
					</h2>
					<div
						class="mt-8 divide-y divide-hairline border-y border-hairline"
					>
						<details class="faq-item">
							<summary
								>Are my photos uploaded to a server?</summary
							>
							<p>
								No. The selected image is processed locally in
								your browser and is not sent to this website.
