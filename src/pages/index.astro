---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="min-h-screen bg-white text-ink">
		<header class="border-b border-hairline">
			<nav
				class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
				aria-label="Main navigation"
			>
				<a
					class="flex items-center gap-2.5 font-semibold tracking-tight"
					href="/"
					aria-label="NSDL Photo Resize home"
				>
					<span class="brand-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<path
								d="M7.25 3.75h6.5l4.5 4.5v11.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5V4.25a.5.5 0 0 1 .5-.5Z"
								stroke="currentColor"
								stroke-width="1.5"></path>
							<path
								d="M13.5 4v4.5H18M9.5 13h6m-6 3h6"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"></path>
						</svg>
					</span>
					<span>NSDL Photo Resize</span>
				</a>
				<div
					class="hidden items-center gap-7 text-sm text-body md:flex"
				>
					<a class="transition hover:text-ink" href="#how-it-works"
						>How it works</a
					>
					<a class="transition hover:text-ink" href="#requirements"
						>Requirements</a
					>
					<a class="transition hover:text-ink" href="#faq">FAQ</a>
				</div>
				<a class="button-primary h-10! px-4!" href="#photo-tool"
					>Resize a photo</a
				>
			</nav>
		</header>

		<main>
			<section
				class="hero-wash px-5 pb-12 pt-16 sm:px-8 sm:pb-16 sm:pt-20"
			>
				<div
					class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.88fr_1.12fr] lg:gap-16"
				>
					<div class="max-w-xl">
						<p class="eyebrow mb-2 sm:mb-5">
							PAN photo &amp; signature tool
						</p>
						<h1
							class="max-w-xl text-[2.6rem] font-semibold leading-[1.05] tracking-[-0.055em] lg:text-5xl"
						>
							Your PAN image, upload-ready.
						</h1>
						<p
							class="mt-5 max-w-lg text-base leading-7 text-body sm:text-lg"
						>
							Crop your photo or signature to PAN dimensions and
							download a clean JPEG right in your browser.
						</p>
						<div class="mt-7 flex flex-wrap items-center gap-3">
							<a class="button-primary" href="#photo-tool">
								Start resizing
								<svg
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
								>
									<path
										d="M4.5 10h11m-4.5-4.5L15.5 10 11 14.5"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</a>
						</div>
						<div
							class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm text-body"
						>
							<span class="inline-flex items-center gap-2">
								<svg
									class="h-5 w-5 shrink-0 text-success"
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
									><path
										d="m4.5 10.5 3.5 3 7.5-8"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
								No account needed
							</span>
							<span class="inline-flex items-center gap-2">
								<svg
									class="h-5 w-5 shrink-0 text-success"
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
									><path
										d="m4.5 10.5 3.5 3 7.5-8"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
								Photo and signature modes
							</span>
							<span class="inline-flex items-center gap-2">
								<svg
									class="h-5 w-5 shrink-0 text-success"
									aria-hidden="true"
									viewBox="0 0 20 20"
									fill="none"
									><path
										d="m4.5 10.5 3.5 3 7.5-8"
										stroke="currentColor"
										stroke-width="1.7"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
								Files stay on your device
							</span>
						</div>
					</div>

					<section
						id="photo-tool"
						class="tool-card scroll-mt-6"
						aria-labelledby="tool-heading"
					>
						<div
							class="flex flex-wrap items-start justify-between gap-4 border-b border-hairline px-5 py-5 sm:px-7"
						>
							<div>
								<h2
									id="tool-heading"
									class="text-lg font-semibold tracking-tight"
								>
									Resize your image
								</h2>
								<p class="mt-1 text-sm text-body">
									Choose an image type to get started.
								</p>
							</div>
							<span class="badge-pill">Free · in-browser</span>
						</div>

						<div class="space-y-5 px-5 py-5 sm:px-7 sm:py-6">
							<div>
								<p class="mb-2.5 text-sm font-medium">
									1. Choose image type
								</p>
								<div
									class="grid grid-cols-2 gap-2 rounded-xl bg-surface-subtle p-1"
									role="group"
									aria-label="Image type"
								>
									<button
										class="mode-button is-active"
										type="button"
										data-mode="photo"
										aria-pressed="true"
									>
										<svg
											aria-hidden="true"
											viewBox="0 0 20 20"
											fill="none"
											><circle
												cx="10"
												cy="7"
												r="3"
												stroke="currentColor"
												stroke-width="1.5"
											></circle><path
												d="M4.5 16c.4-2.5 2.3-3.8 5.5-3.8s5.1 1.3 5.5 3.8"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linecap="round"
											></path></svg
										>
										Photograph
									</button>
									<button
										class="mode-button"
										type="button"
										data-mode="signature"
										aria-pressed="false"
									>
										<svg
											aria-hidden="true"
											viewBox="0 0 20 20"
											fill="none"
											><path
												d="m4 13.7 8.7-8.8a1.5 1.5 0 0 1 2.1 2.2L6 15.8l-3 .8.9-2.9Z"
												stroke="currentColor"
												stroke-width="1.5"
												stroke-linejoin="round"
											></path><path
												d="M10.8 7l2.2 2.2"
												stroke="currentColor"
												stroke-width="1.5"></path></svg
										>
										Signature
									</button>
								</div>
							</div>

							<div id="drop-zone" class="drop-zone">
								<input
									id="file-input"
									class="sr-only"
									type="file"
									accept="image/jpeg,image/png,image/webp"
								/>
								<div class="drop-placeholder">
									<span
										class="upload-icon"
										aria-hidden="true"
									>
										<svg viewBox="0 0 24 24" fill="none"
											><path
												d="M12 15V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14.5v4A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5v-4"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path></svg
										>
									</span>
									<strong
										class="mt-3 block text-sm font-semibold"
										>Drop your image here</strong
									>
									<span class="mt-1 block text-sm text-body"
										>or choose a file from your device</span
									>
									<span
										class="mt-3 inline-flex min-h-10 items-center rounded-lg border border-hairline-strong bg-white px-4 text-sm font-medium transition hover:bg-surface-soft"
										>Choose image</span
									>
									<span class="mt-3 block text-xs text-muted"
										>JPG, PNG or WebP · images are not
										uploaded</span
									>
								</div>
								<div class="editor-preview" hidden>
									<canvas
										id="preview-canvas"
										tabindex="0"
										aria-label="Image crop preview. Drag to reposition, or use arrow keys to nudge the image."
									></canvas>
									<div class="canvas-hint">
										Drag to reposition · arrow keys to nudge
									</div>
								</div>
							</div>

							<div class="grid gap-4 sm:grid-cols-2">
								<label class="field-label">
									<span
										class="flex items-center justify-between gap-2"
									>
										Zoom <span
											id="zoom-value"
											class="font-normal text-body"
											>100%</span
										>
									</span>
									<input
										id="zoom"
										class="zoom-range"
										type="range"
										min="100"
										max="300"
										value="100"
										step="1"
										disabled
									/>
								</label>
								<label class="field-label">
									<span
										>Maximum file size <span
											class="font-normal text-muted"
											>(KB)</span
										></span
									>
									<input
										id="max-kb"
										class="form-control"
										type="number"
										value="50"
										readonly
										aria-readonly="true"
									/>
								</label>
							</div>

							<div class="grid gap-4 sm:grid-cols-2">
								<label class="field-label">
									<span>Application Portal</span>
									<select id="provider" class="form-control">
										<option value="protean"
											>Protean (formerly NSDL)</option
										>
										<option value="uti">UTIITSL</option>
									</select>
								</label>
								<label class="field-label">
									<span>Resolution (minimum 200 DPI)</span>
									<select id="dpi" class="form-control">
										<option value="200" selected
											>200 DPI</option
										>
										<option value="300">300 DPI</option>
										<option value="600">600 DPI</option>
									</select>
								</label>
							</div>
							<p class="-mt-2 text-xs leading-5 text-body">
								The photo and signature dimensions are the same
								for both portals; check official instructions if
								your application type differs. <br />
								<a
									id="provider-guide"
									class="text-link"
									href="https://tinpan.proteantech.in/"
									target="_blank"
									rel="noreferrer"
									>Open Protean PAN portal ↗</a
								>
							</p>

							<div class="grid grid-cols-2 gap-3">
								<label class="field-label">
									<span
										>Width <span
											class="font-normal text-muted"
											>(cm)</span
										></span
									>
									<input
										id="width-cm"
										class="form-control"
										type="number"
										value="2.5"
										readonly
										aria-readonly="true"
									/>
								</label>
								<label class="field-label">
									<span
										>Height <span
											class="font-normal text-muted"
											>(cm)</span
										></span
									>
									<input
										id="height-cm"
										class="form-control"
										type="number"
										value="3.5"
										readonly
										aria-readonly="true"
									/>
								</label>
							</div>
							<p
								id="capture-guidance"
								class="-mt-2 text-xs leading-5 text-body"
							>
								Use a clear, recent photograph with a plain
								white background.
							</p>

							<div
								class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-surface-soft px-4 py-3"
							>
								<div class="text-sm">
									<p
										id="output-dimensions"
										class="font-medium"
									>
										295 × 413 px
									</p>
									<p
										id="file-details"
										class="mt-0.5 text-xs text-body"
									>
										JPEG resolution metadata: 200 DPI
									</p>
								</div>
								<label class="field-label filename-field">
									<span class="sr-only"
										>Download filename</span
									>
									<input
										id="filename"
										class="filename-input"
										type="text"
										value="pan-photo.jpeg"
										aria-label="Download filename"
									/>
								</label>
							</div>

							<div class="flex flex-col gap-3 sm:flex-row">
								<button
									id="download"
									class="button-primary flex-1 justify-center disabled:cursor-not-allowed disabled:opacity-45"
									type="button"
									disabled
								>
									Download JPEG
									<svg
										aria-hidden="true"
										viewBox="0 0 20 20"
										fill="none"
										><path
											d="M10 3.5v9m0 0 3.5-3.5M10 12.5 6.5 9M4.5 14.5v1A1.5 1.5 0 0 0 6 17h8a1.5 1.5 0 0 0 1.5-1.5v-1"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"></path></svg
									>
								</button>
								<button
									id="remove-image"
									class="button-secondary justify-center disabled:cursor-not-allowed disabled:opacity-45"
									type="button"
									disabled>Start over</button
								>
							</div>
							<p
								id="status"
								class="status-message"
								role="status"
								aria-live="polite"
							>
							</p>
							<p class="text-xs leading-5 text-body">
								Photo: 2.5 × 3.5 cm. Signature: 2 × 4.5 cm. Both
								exports are prepared at 200 DPI or higher and
								compressed to under 50 KB. Check the selected
								portal’s current instructions if your
								application type differs.
							</p>
						</div>
					</section>
				</div>
			</section>

			<section class="px-5 py-16 sm:px-8 sm:py-20" id="how-it-works">
				<div class="mx-auto max-w-6xl">
					<div class="max-w-xl">
						<p class="eyebrow mb-3">Simple by design</p>
						<h2 class="section-heading">
							From camera roll to the right crop in a few steps.
						</h2>
						<p class="mt-4 leading-7 text-body">
							No account, downloads, or complicated editor to
							learn. Keep control of your image from start to
							finish.
						</p>
					</div>
					<ol class="mt-9 grid gap-4 md:grid-cols-3">
						<li class="step-card">
							<span class="step-number">01</span>
							<h3 class="mt-5 font-semibold">
								Choose a photo or signature
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Select the image type and the portal you’re
								applying through.
							</p>
						</li>
						<li class="step-card">
							<span class="step-number">02</span>
							<h3 class="mt-5 font-semibold">
								Position and check it
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Move and zoom your image, then review the output
								dimensions and file size.
							</p>
						</li>
						<li class="step-card">
							<span class="step-number">03</span>
							<h3 class="mt-5 font-semibold">
								Download your JPEG
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Save the result locally, then confirm it matches
								the portal’s latest requirements.
							</p>
						</li>
					</ol>
				</div>
			</section>

			<section
				id="requirements"
				class="border-y border-hairline bg-surface-soft px-5 py-16 sm:px-8 sm:py-20"
			>
				<div
					class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr]"
				>
					<div>
						<p class="eyebrow mb-3">Before you upload</p>
						<h2 class="section-heading">
							A quick check now can save a rejected application
							later.
						</h2>
						<p class="mt-4 leading-7 text-body">
							The tool prepares PAN photos and signatures to the
							dimensions shown, at 200 DPI or higher, and under 50
							KB each. Application-specific instructions can
							differ, so check the portal before you submit.
						</p>
						<div class="mt-5 flex flex-wrap gap-3">
							<a
								class="text-link"
								href="https://tinpan.proteantech.in/"
								target="_blank"
								rel="noreferrer"
								>Protean PAN portal <span aria-hidden="true"
									>↗</span
								></a
							>
							<a
								class="text-link"
								href="https://www.utiitsl.com/"
								target="_blank"
								rel="noreferrer"
								>UTIITSL website <span aria-hidden="true"
									>↗</span
								></a
							>
						</div>
					</div>
					<div class="grid gap-3 sm:grid-cols-2">
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M5 6.5h14A1.5 1.5 0 0 1 20.5 8v9a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 17V8A1.5 1.5 0 0 1 5 6.5Z"
										stroke="currentColor"
										stroke-width="1.5"></path><circle
										cx="9"
										cy="11"
										r="1.5"
										stroke="currentColor"
										stroke-width="1.5"></circle><path
										d="m4 17 4.2-3.5a1 1 0 0 1 1.3 0l2 1.7 2.7-2.3a1 1 0 0 1 1.3 0L20 16.5"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Use a clear image
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Choose a well-lit, sharp photo against a plain
								white background. Avoid filters and glare.
							</p>
						</article>
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M4 7.5h16M4 12h16M4 16.5h10"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path><circle
										cx="18"
										cy="16.5"
										r="2"
										stroke="currentColor"
										stroke-width="1.5"></circle></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Check the exact limits
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Photo: 2.5 × 3.5 cm. Signature: 2 × 4.5 cm. Keep
								each JPEG under 50 KB.
							</p>
						</article>
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M7 4h7l4 4v12H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"
										stroke="currentColor"
										stroke-width="1.5"></path><path
										d="M14 4v5h5M9 14h6m-6 3h6"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Keep the original
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Your source image remains unchanged. You can
								adjust the crop and download again.
							</p>
						</article>
						<article class="requirement-card">
							<span class="requirement-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none"
									><path
										d="M12 3.5 5 6v5.5c0 4.2 2.7 7.5 7 9 4.3-1.5 7-4.8 7-9V6l-7-2.5Z"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"></path><path
										d="m9 12 2 2 4-4"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path></svg
								>
							</span>
							<h3 class="mt-4 font-semibold">
								Your image stays private
							</h3>
							<p class="mt-2 text-sm leading-6 text-body">
								Image selection, preview, and export run in your
								browser; no image upload is used.
							</p>
						</article>
					</div>
				</div>
			</section>

			<section id="faq" class="px-5 py-16 sm:px-8 sm:py-20">
				<div class="mx-auto max-w-3xl">
					<p class="eyebrow mb-3 text-center">Good to know</p>
					<h2 class="section-heading text-center">
						Frequently asked questions
					</h2>
					<div
						class="mt-8 divide-y divide-hairline border-y border-hairline"
					>
						<details class="faq-item">
							<summary
								>Are my photos uploaded to a server?</summary
							>
							<p>
								No. The selected image is processed locally in
								your browser and is not sent to this website.
								Downloading the result saves a new file to your
								device.
							</p>
						</details>
						<details class="faq-item">
							<summary
								>Are the displayed dimensions guaranteed to
								work?</summary
							>
							<p>
								The tool uses a 2.5 × 3.5 cm photo and a 2 × 4.5
								cm signature, at 200 DPI or higher, with each
								JPEG compressed to under 50 KB. Check the
								selected provider’s portal if your application
								type has different instructions.
							</p>
						</details>
						<details class="faq-item">
							<summary>Can I reduce the JPEG file size?</summary>
							<p>
								Yes. Each JPEG is automatically compressed to
								stay under 50 KB. If a complex image cannot
								reach the limit at its minimum quality setting,
								the tool will ask you to try a simpler image
								rather than export an oversized file.
							</p>
						</details>
						<details class="faq-item">
							<summary
								>What can I do if the crop looks wrong?</summary
							>
							<p>
								Drag the preview or use the arrow keys to
								reposition it, adjust the zoom, or choose
								another image. The original file is not
								modified.
							</p>
						</details>
					</div>
				</div>
			</section>
		</main>

		<footer class="border-t border-hairline px-5 py-8 sm:px-8">
			<div
				class="mx-auto flex max-w-6xl flex-col gap-3 text-sm text-body sm:flex-row sm:items-center sm:justify-between"
			>
				<p class="font-medium text-ink">NSDL Photo Resize</p>
				<p>
					Independent image utility. Not affiliated with Protean,
					NSDL, or UTIITSL.
				</p>
				<a class="text-link" href="#photo-tool">Back to tool ↑</a>
			</div>
		</footer>
	</div>

	<script>
		function getElement<T extends HTMLElement>(selector: string): T {
			const element = document.querySelector<T>(selector);
			if (!element)
				throw new Error(
					`Required page element is missing: ${selector}`,
				);
			return element;
		}

		const fileInput = getElement<HTMLInputElement>("#file-input");
		const dropZone = getElement<HTMLDivElement>("#drop-zone");
		const canvas = getElement<HTMLCanvasElement>("#preview-canvas");
		const context = canvas.getContext("2d");
		const zoomInput = getElement<HTMLInputElement>("#zoom");
		const zoomValue = getElement<HTMLSpanElement>("#zoom-value");
		const providerInput = getElement<HTMLSelectElement>("#provider");
		const providerGuide = getElement<HTMLAnchorElement>("#provider-guide");
		const captureGuidance =
			getElement<HTMLParagraphElement>("#capture-guidance");
		const dpiInput = getElement<HTMLSelectElement>("#dpi");
		const widthInput = getElement<HTMLInputElement>("#width-cm");
		const heightInput = getElement<HTMLInputElement>("#height-cm");
		const filenameInput = getElement<HTMLInputElement>("#filename");
		const outputDimensions =
			getElement<HTMLParagraphElement>("#output-dimensions");
		const fileDetails = getElement<HTMLParagraphElement>("#file-details");
		const downloadButton = getElement<HTMLButtonElement>("#download");
		const removeButton = getElement<HTMLButtonElement>("#remove-image");
		const status = getElement<HTMLParagraphElement>("#status");
		const placeholder = getElement<HTMLDivElement>(".drop-placeholder");
		const editorPreview = getElement<HTMLDivElement>(".editor-preview");
		const modeButtons = [
			...document.querySelectorAll<HTMLButtonElement>("[data-mode]"),
		];
		const maxOutputDimension = 3000;
		const cmPerInch = 2.54;
		let image: HTMLImageElement | null = null;
		let imageUrl = "";
		let mode: "photo" | "signature" = "photo";
		let zoom = 1;
		let offsetX = 0;
		let offsetY = 0;
		let dragStart: { x: number; y: number } | null = null;
		const maxFileSizeKb = 50;

		function setStatus(message: string, kind = "") {
			status.textContent = message;
			status.dataset.kind = kind;
		}

		function dimensions() {
			const widthCm = Number(widthInput.value);
			const heightCm = Number(heightInput.value);
			const dpi = Math.max(200, Number(dpiInput.value));
			if (
				!Number.isFinite(widthCm) ||
				!Number.isFinite(heightCm) ||
				widthCm <= 0 ||
				heightCm <= 0
			) {
				return null;
			}
			const width = Math.round((widthCm / cmPerInch) * dpi);
			const height = Math.round((heightCm / cmPerInch) * dpi);
			if (width > maxOutputDimension || height > maxOutputDimension) {
				return null;
			}
			return { width, height, dpi };
		}

		function updateDimensions() {
			const output = dimensions();
			if (!output) {
				outputDimensions.textContent = "Check output size";
				fileDetails.textContent = `Each side must be no more than ${maxOutputDimension} px`;
				downloadButton.disabled = true;
				return;
			}
			outputDimensions.textContent = `${output.width} × ${output.height} px`;
			fileDetails.textContent = `JPEG resolution metadata: ${output.dpi} DPI`;
			if (canvas) {
				canvas.width = output.width;
				canvas.height = output.height;
			}
			drawPreview();
			downloadButton.disabled = !image;
		}

		function drawPreview() {
			if (
				!image ||
				!canvas ||
				!context ||
				!canvas.width ||
				!canvas.height
			)
				return;
			context.fillStyle = "#fff";
			context.fillRect(0, 0, canvas.width, canvas.height);
			const fit = Math.max(
				canvas.width / image.naturalWidth,
				canvas.height / image.naturalHeight,
			);
			const drawWidth = image.naturalWidth * fit * zoom;
			const drawHeight = image.naturalHeight * fit * zoom;
			context.drawImage(
				image,
				(canvas.width - drawWidth) / 2 + offsetX,
				(canvas.height - drawHeight) / 2 + offsetY,
				drawWidth,
				drawHeight,
			);
		}

		function setMode(nextMode: "photo" | "signature") {
			mode = nextMode;
			const preset =
				nextMode === "photo"
					? { width: 2.5, height: 3.5 }
					: { width: 2, height: 4.5 };
			widthInput.value = String(preset.width);
			heightInput.value = String(preset.height);
			filenameInput.value =
				nextMode === "photo" ? "pan-photo.jpeg" : "pan-signature.jpeg";
			captureGuidance.textContent =
				nextMode === "photo"
					? "Use a clear, recent photograph with a plain white background."
					: "Sign with dark ink on plain white paper, then photograph or scan the signature clearly.";
			modeButtons.forEach((button) => {
				const active = button.dataset.mode === mode;
				button.classList.toggle("is-active", active);
				button.setAttribute("aria-pressed", String(active));
			});
			zoom = 1;
			offsetX = 0;
			offsetY = 0;
			zoomInput.value = "100";
			zoomValue.textContent = "100%";
			updateDimensions();
		}

		function updateProviderGuide() {
			const isUti = providerInput.value === "uti";
			providerGuide.href = isUti
				? "https://www.utiitsl.com/UTIITSL_SITE/pan/index.html"
				: "https://tinpan.proteantech.in/";
			providerGuide.textContent = isUti
				? "Open UTIITSL PAN page ↗"
				: "Open Protean PAN portal ↗";
		}

		function loadFile(file: File | undefined) {
			if (!file) return;
			if (
				!["image/jpeg", "image/png", "image/webp"].includes(file.type)
			) {
				setStatus("Choose a JPG, PNG, or WebP image.", "error");
				return;
			}
			if (file.size > 20 * 1024 * 1024) {
				setStatus(
					"This image is larger than 20 MB. Choose a smaller file.",
					"error",
				);
				return;
			}

			const nextUrl = URL.createObjectURL(file);
			const nextImage = new Image();
			nextImage.onload = () => {
				if (imageUrl) URL.revokeObjectURL(imageUrl);
				imageUrl = nextUrl;
				image = nextImage;
				placeholder.hidden = true;
				editorPreview.hidden = false;
				zoomInput.disabled = false;
				removeButton.disabled = false;
				zoom = 1;
				offsetX = 0;
				offsetY = 0;
				updateDimensions();
				setStatus(
					`${file.name} is ready. Drag the preview to adjust the crop.`,
				);
			};
			nextImage.onerror = () => {
				URL.revokeObjectURL(nextUrl);
				setStatus(
					"This image could not be opened. Try another file.",
					"error",
				);
			};
			nextImage.src = nextUrl;
		}

		function resetImage() {
			if (imageUrl) URL.revokeObjectURL(imageUrl);
			imageUrl = "";
			image = null;
			fileInput.value = "";
			placeholder.hidden = false;
			editorPreview.hidden = true;
			zoomInput.disabled = true;
			removeButton.disabled = true;
			downloadButton.disabled = true;
			zoom = 1;
			offsetX = 0;
			offsetY = 0;
			zoomInput.value = "100";
			zoomValue.textContent = "100%";
			if (context && canvas)
				context.clearRect(0, 0, canvas.width, canvas.height);
			setStatus("");
		}

		function getBlob(quality: number): Promise<Blob> {
			return new Promise<Blob>((resolve, reject) => {
				canvas.toBlob(
					(blob) => {
						if (blob) resolve(blob);
						else
							reject(
								new Error(
									"The browser could not create a JPEG from this image.",
								),
							);
					},
					"image/jpeg",
					quality,
				);
			});
		}

		async function addJfifDensity(blob: Blob, dpi: number): Promise<Blob> {
			const bytes = new Uint8Array(await blob.arrayBuffer());
			if (bytes[0] !== 0xff || bytes[1] !== 0xd8) {
				throw new Error("The browser returned an invalid JPEG image.");
			}
			const density = Math.min(65535, Math.max(1, Math.round(dpi)));
			let offset = 2;
			while (offset < bytes.length && bytes[offset] === 0xff) {
				while (bytes[offset] === 0xff) offset += 1;
				const marker = bytes[offset];
				offset += 1;
				if (marker === 0xd9 || marker === 0xda) break;
				if (
					marker === 0x00 ||
					marker === 0xd8 ||
					offset + 2 > bytes.length
				) {
					throw new Error(
						"The JPEG image contains an invalid metadata segment.",
					);
				}
				const segmentLength = (bytes[offset] << 8) | bytes[offset + 1];
				if (
					segmentLength < 2 ||
					offset + segmentLength > bytes.length
				) {
					throw new Error(
						"The JPEG image contains an invalid metadata segment.",
					);
				}
				const payload = offset + 2;
				const isJfif =
					marker === 0xe0 &&
					segmentLength >= 16 &&
					bytes[payload] === 0x4a &&
					bytes[payload + 1] === 0x46 &&
					bytes[payload + 2] === 0x49 &&
					bytes[payload + 3] === 0x46 &&
					bytes[payload + 4] === 0;
				if (isJfif) {
					bytes[payload + 7] = 1;
					bytes[payload + 8] = (density >> 8) & 0xff;
					bytes[payload + 9] = density & 0xff;
					bytes[payload + 10] = (density >> 8) & 0xff;
					bytes[payload + 11] = density & 0xff;
					return new Blob([bytes], { type: "image/jpeg" });
				}
				offset += segmentLength;
			}

			const app0 = new Uint8Array([
				0xff,
				0xe0,
				0x00,
				0x10,
				0x4a,
				0x46,
				0x49,
				0x46,
				0x00,
				0x01,
				0x01,
				0x01,
				(density >> 8) & 0xff,
				density & 0xff,
				(density >> 8) & 0xff,
				density & 0xff,
				0x00,
				0x00,
			]);
			const result = new Uint8Array(bytes.length + app0.length);
			result.set(bytes.subarray(0, 2));
			result.set(app0, 2);
			result.set(bytes.subarray(2), app0.length + 2);
			return new Blob([result], { type: "image/jpeg" });
		}

		async function exportImage() {
			if (!image) {
				setStatus("Choose an image before downloading.", "error");
				return;
			}
			const output = dimensions();
			if (!output) {
				setStatus(
					"Enter valid dimensions that produce an output of 3000 px or less per side.",
					"error",
				);
				return;
			}
			downloadButton.disabled = true;
			setStatus("Preparing your JPEG…");
			try {
				let blob = await addJfifDensity(
					await getBlob(0.92),
					output.dpi,
				);
				if (maxFileSizeKb > 0) {
					let low = 0.1;
					let high = 0.92;
					for (
						let attempt = 0;
						attempt < 10 && blob.size >= maxFileSizeKb * 1024;
						attempt += 1
					) {
						const quality = (low + high) / 2;
						const candidate = await addJfifDensity(
							await getBlob(quality),
							output.dpi,
						);
						if (candidate.size >= maxFileSizeKb * 1024)
							high = quality;
						else {
							low = quality;
							blob = candidate;
						}
					}
					if (blob.size >= maxFileSizeKb * 1024) {
						blob = await addJfifDensity(
							await getBlob(low),
							output.dpi,
						);
					}
					if (blob.size >= maxFileSizeKb * 1024) {
						setStatus(
							`This image cannot be compressed to under ${maxFileSizeKb} KB at the required dimensions. Try a simpler image.`,
							"error",
						);
						return;
					}
				}

				const objectUrl = URL.createObjectURL(blob);
				const anchor = document.createElement("a");
				const safeName = filenameInput.value
					.trim()
					.replace(/[\\/:*?"<>|]/g, "-");
				anchor.href = objectUrl;
				anchor.download = safeName
					? /\.(jpe?g)$/i.test(safeName)
						? safeName
						: `${safeName}.jpeg`
					: `pan-${mode}.jpeg`;
				document.body.append(anchor);
				anchor.click();
				anchor.remove();
				window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
				const sizeKb = (blob.size / 1024).toFixed(1);
				setStatus(
					`JPEG downloaded · ${output.width} × ${output.height} px · ${sizeKb} KB.`,
				);
			} catch (error) {
				setStatus(
					error instanceof Error
						? error.message
						: "The image could not be exported. Try again.",
					"error",
				);
			} finally {
				downloadButton.disabled = !image;
			}
		}

		modeButtons.forEach((button) =>
			button.addEventListener("click", () => {
				const nextMode = button.dataset.mode;
				if (nextMode === "photo" || nextMode === "signature")
					setMode(nextMode);
			}),
		);
		providerInput.addEventListener("change", updateProviderGuide);
		fileInput.addEventListener("change", (event) => {
			if (event.currentTarget instanceof HTMLInputElement)
				loadFile(event.currentTarget.files?.[0]);
		});
		dropZone.addEventListener("click", (event) => {
			if (
				event.target instanceof Element &&
				event.target.closest("canvas")
			)
				return;
			fileInput.click();
		});
		dropZone.addEventListener("dragover", (event) => {
			event.preventDefault();
			dropZone.classList.add("is-dragging");
		});
		dropZone.addEventListener("dragleave", (event) => {
			if (
				!(event.relatedTarget instanceof Node) ||
				!dropZone.contains(event.relatedTarget)
			) {
				dropZone.classList.remove("is-dragging");
			}
		});
		dropZone.addEventListener("drop", (event) => {
			event.preventDefault();
			dropZone.classList.remove("is-dragging");
			if (!event.dataTransfer) return;
			loadFile(event.dataTransfer.files?.[0]);
		});
		zoomInput.addEventListener("input", () => {
			zoom = Number(zoomInput.value) / 100;
			zoomValue.textContent = `${zoomInput.value}%`;
			drawPreview();
		});
		[dpiInput, widthInput, heightInput].forEach((input) =>
			input.addEventListener("input", updateDimensions),
		);
		downloadButton.addEventListener("click", exportImage);
		removeButton.addEventListener("click", resetImage);

		canvas.addEventListener("pointerdown", (event) => {
			if (!image) return;
			canvas.setPointerCapture(event.pointerId);
			dragStart = { x: event.clientX, y: event.clientY };
		});
		canvas.addEventListener("pointermove", (event) => {
			if (!dragStart) return;
			const bounds = canvas.getBoundingClientRect();
			offsetX +=
				((event.clientX - dragStart.x) * canvas.width) / bounds.width;
			offsetY +=
				((event.clientY - dragStart.y) * canvas.height) / bounds.height;
			dragStart = { x: event.clientX, y: event.clientY };
			drawPreview();
		});
		canvas.addEventListener("pointerup", () => {
			dragStart = null;
		});
		canvas.addEventListener("pointercancel", () => {
			dragStart = null;
		});
		canvas.addEventListener("keydown", (event) => {
			const step = event.shiftKey ? 20 : 5;
			if (event.key === "ArrowLeft") offsetX -= step;
			else if (event.key === "ArrowRight") offsetX += step;
			else if (event.key === "ArrowUp") offsetY -= step;
			else if (event.key === "ArrowDown") offsetY += step;
			else return;
			event.preventDefault();
			drawPreview();
		});

		setMode("photo");
		updateProviderGuide();
	</script>
</Layout>
