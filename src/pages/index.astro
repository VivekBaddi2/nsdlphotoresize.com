		</main>

		<SiteFooter />
	</div>

	<script>
		function getElement<T extends HTMLElement>(selector: string): T {
			const element = document.querySelector<T>(selector);
			if (!element)
				throw new Error(
					`Required page element is missing: ${selector}`,
				);
			return element;
		}

		function getCanvasContext(
			canvas: HTMLCanvasElement,
		): CanvasRenderingContext2D {
			const context = canvas.getContext("2d");
			if (!context)
				throw new Error(
					"The browser could not initialize the image cropper.",
				);
			return context;
		}

		const fileInput = getElement<HTMLInputElement>("#file-input");
		const dropZone = getElement<HTMLDivElement>("#drop-zone");
		const modeControls = getElement<HTMLDivElement>("#mode-controls");
		const editorControls = getElement<HTMLDivElement>("#editor-controls");
		const cropStage = getElement<HTMLDivElement>(".crop-stage");
		const cropSelection = getElement<HTMLDivElement>(".crop-selection");
		const canvas = getElement<HTMLCanvasElement>("#preview-canvas");
		const previewContext = getCanvasContext(canvas);
		const outputCanvas = document.createElement("canvas");
		const outputContext = getCanvasContext(outputCanvas);
		const captureGuidance =
			getElement<HTMLParagraphElement>("#capture-guidance");
		const dpiInput = getElement<HTMLSelectElement>("#dpi");
		const portalPresetInput =
			getElement<HTMLSelectElement>("#portal-preset");
		const widthInput = getElement<HTMLInputElement>("#width-cm");
		const heightInput = getElement<HTMLInputElement>("#height-cm");
		const maxKbInput = getElement<HTMLInputElement>("#max-kb");
		const filenameInput = getElement<HTMLInputElement>("#filename");
		const outputDimensions =
			getElement<HTMLParagraphElement>("#output-dimensions");
		const fileDetails = getElement<HTMLParagraphElement>("#file-details");
		const downloadButton = getElement<HTMLButtonElement>("#download");
		const removeButton = getElement<HTMLButtonElement>("#remove-image");
		const placeholder = getElement<HTMLDivElement>(".drop-placeholder");
		const editorPreview = getElement<HTMLDivElement>(".editor-preview");
		const modeButtons = [
			...document.querySelectorAll<HTMLButtonElement>("[data-mode]"),
		];
		const maxOutputDimension = 3000;
		const cmPerInch = 2.54;
		let image: HTMLImageElement | null = null;
		let imageUrl = "";
		let mode: "photo" | "signature" = "photo";
		let cropRect: {
			x: number;
			y: number;
			width: number;
			height: number;
		} | null = null;
		let cropRatio = 0;
		let dragState: {
			pointerId: number;
			startX: number;
			startY: number;
			initialCrop: {
				x: number;
				y: number;
				width: number;
				height: number;
			};
			corner: string | null;
		} | null = null;
		let maxFileSizeKb = 50;

		function dimensions() {
			const widthCm = Number(widthInput.value);
			const heightCm = Number(heightInput.value);
			const dpi = Math.max(200, Number(dpiInput.value));
			if (
				!Number.isFinite(widthCm) ||
				!Number.isFinite(heightCm) ||
				widthCm <= 0 ||
				heightCm <= 0
			) {
				return null;
			}
			const width = Math.round((widthCm / cmPerInch) * dpi);
			const height = Math.round((heightCm / cmPerInch) * dpi);
			if (width > maxOutputDimension || height > maxOutputDimension) {
				return null;
			}
			return { width, height, dpi };
		}

		function updateDimensions() {
			const output = dimensions();
			if (!output) {
				outputDimensions.textContent = "Check output size";
				fileDetails.textContent = `Each side must be no more than ${maxOutputDimension} px`;
				downloadButton.disabled = true;
				return;
			}
			outputDimensions.textContent = `${output.width} × ${output.height} px`;
			fileDetails.textContent = `JPEG resolution metadata: ${output.dpi} DPI`;
			if (
				outputCanvas.width !== output.width ||
				outputCanvas.height !== output.height
			) {
				outputCanvas.width = output.width;
				outputCanvas.height = output.height;
			}
			const nextRatio = output.width / output.height;
			if (
				image &&
				(!cropRect || Math.abs(nextRatio - cropRatio) > 0.001)
			) {
				const centerX = cropRect
					? cropRect.x + cropRect.width / 2
					: image.naturalWidth / 2;
				const centerY = cropRect
					? cropRect.y + cropRect.height / 2
					: image.naturalHeight / 2;
				const maxWidth = Math.min(
					centerX * 2,
					(image.naturalWidth - centerX) * 2,
					centerY * 2 * nextRatio,
					(image.naturalHeight - centerY) * 2 * nextRatio,
				);
				const width = maxWidth * 0.85;
				const height = width / nextRatio;
				cropRect = {
					x: centerX - width / 2,
					y: centerY - height / 2,
					width,
					height,
				};
			}
			cropRatio = nextRatio;
			drawPreview();
			downloadButton.disabled = !image;
		}

		function updateCropSelection() {
			if (!image || !cropRect) return;
			const bounds = canvas.getBoundingClientRect();
			if (!bounds.width) return;
			const displayScale = bounds.width / image.naturalWidth;
			cropSelection.style.left = `${cropRect.x * displayScale}px`;
			cropSelection.style.top = `${cropRect.y * displayScale}px`;
			cropSelection.style.width = `${cropRect.width * displayScale}px`;
			cropSelection.style.height = `${cropRect.height * displayScale}px`;
		}

		function drawPreview() {
			if (!image || !cropRect || !canvas.width || !canvas.height) return;
			const previewScale = Math.min(
				1,
				1000 / image.naturalWidth,
				800 / image.naturalHeight,
			);
			const previewWidth = Math.max(
				1,
				Math.round(image.naturalWidth * previewScale),
			);
			const previewHeight = Math.max(
				1,
				Math.round(image.naturalHeight * previewScale),
			);
			if (
				canvas.width !== previewWidth ||
				canvas.height !== previewHeight
			) {
				canvas.width = previewWidth;
				canvas.height = previewHeight;
			}
			previewContext.clearRect(0, 0, canvas.width, canvas.height);
			previewContext.drawImage(image, 0, 0, canvas.width, canvas.height);
			updateCropSelection();

			outputContext.fillStyle = "#fff";
			outputContext.fillRect(
				0,
				0,
				outputCanvas.width,
				outputCanvas.height,
			);
			outputContext.drawImage(
				image,
				cropRect.x,
				cropRect.y,
				cropRect.width,
				cropRect.height,
				0,
				0,
				outputCanvas.width,
				outputCanvas.height,
			);
		}

		function setMode(nextMode: "photo" | "signature") {
			mode = nextMode;
			const preset =
				portalPresetInput.value === "uti"
					? nextMode === "photo"
						? {
								width: (213 * cmPerInch) / 300,
								height: (213 * cmPerInch) / 300,
								dpi: 300,
								maxKb: 30,
							}
						: {
								width: (400 * cmPerInch) / 600,
								height: (200 * cmPerInch) / 600,
								dpi: 600,
								maxKb: 60,
							}
					: nextMode === "photo"
						? { width: 2.5, height: 3.5, dpi: 200, maxKb: 50 }
						: { width: 4.5, height: 2, dpi: 200, maxKb: 50 };
			widthInput.value = String(preset.width);
			heightInput.value = String(preset.height);
			dpiInput.value = String(preset.dpi);
			maxFileSizeKb = preset.maxKb;
			maxKbInput.value = String(preset.maxKb);
			filenameInput.value =
				nextMode === "photo" ? "pan-photo.jpeg" : "pan-signature.jpeg";
			captureGuidance.textContent =
				nextMode === "photo"
					? "Use a clear, recent color photograph with a plain white background."
					: portalPresetInput.value === "uti"
						? "Sign with black ink on plain white paper, then photograph or scan the signature clearly."
						: "Sign with black or blue ink on plain white paper, then photograph or scan the signature clearly.";
			modeButtons.forEach((button) => {
				const active = button.dataset.mode === mode;
				button.classList.toggle("is-active", active);
				button.setAttribute("aria-pressed", String(active));
			});
			updateDimensions();
		}

		function loadFile(file: File | undefined) {
			if (!file) return;
			if (
				!["image/jpeg", "image/png", "image/webp"].includes(file.type)
			) {
				window.alert("Choose a JPG, PNG, or WebP image.");
				return;
			}
			if (file.size > 20 * 1024 * 1024) {
				window.alert(
					"This image is larger than 20 MB. Choose a smaller file.",
				);
				return;
			}

			const nextUrl = URL.createObjectURL(file);
			const nextImage = new Image();
			nextImage.onload = () => {
				if (imageUrl) URL.revokeObjectURL(imageUrl);
				imageUrl = nextUrl;
				image = nextImage;
				placeholder.hidden = true;
				editorPreview.hidden = false;
				modeControls.hidden = false;
				editorControls.hidden = false;
				removeButton.disabled = false;
				dragState = null;
				cropRect = null;
				cropRatio = 0;
				updateDimensions();
			};
			nextImage.onerror = () => {
				URL.revokeObjectURL(nextUrl);
				window.alert("This image could not be opened. Try another file.");
			};
			nextImage.src = nextUrl;
		}

		function resetImage() {
			if (imageUrl) URL.revokeObjectURL(imageUrl);
			imageUrl = "";
			image = null;
			fileInput.value = "";
			placeholder.hidden = false;
			editorPreview.hidden = true;
			modeControls.hidden = true;
			editorControls.hidden = true;
			removeButton.disabled = true;
			downloadButton.disabled = true;
			dragState = null;
			cropRect = null;
			cropRatio = 0;
			previewContext.clearRect(0, 0, canvas.width, canvas.height);
			outputContext.clearRect(
				0,
				0,
				outputCanvas.width,
				outputCanvas.height,
			);
		}

		function getBlob(quality: number): Promise<Blob> {
			return new Promise<Blob>((resolve, reject) => {
				outputCanvas.toBlob(
					(blob) => {
						if (blob) resolve(blob);
						else
							reject(
								new Error(
									"The browser could not create a JPEG from this image.",
								),
							);
					},
					"image/jpeg",
					quality,
				);
			});
		}

		async function addJfifDensity(blob: Blob, dpi: number): Promise<Blob> {
			const bytes = new Uint8Array(await blob.arrayBuffer());
			if (bytes[0] !== 0xff || bytes[1] !== 0xd8) {
				throw new Error("The browser returned an invalid JPEG image.");
			}
			const density = Math.min(65535, Math.max(1, Math.round(dpi)));
			let offset = 2;
			while (offset < bytes.length && bytes[offset] === 0xff) {
				while (bytes[offset] === 0xff) offset += 1;
				const marker = bytes[offset];
				offset += 1;
				if (marker === 0xd9 || marker === 0xda) break;
				if (
					marker === 0x00 ||
					marker === 0xd8 ||
					offset + 2 > bytes.length
				) {
					throw new Error(
						"The JPEG image contains an invalid metadata segment.",
					);
				}
				const segmentLength = (bytes[offset] << 8) | bytes[offset + 1];
				if (
					segmentLength < 2 ||
					offset + segmentLength > bytes.length
				) {
					throw new Error(
						"The JPEG image contains an invalid metadata segment.",
					);
				}
				const payload = offset + 2;
				const isJfif =
					marker === 0xe0 &&
					segmentLength >= 16 &&
					bytes[payload] === 0x4a &&
					bytes[payload + 1] === 0x46 &&
					bytes[payload + 2] === 0x49 &&
					bytes[payload + 3] === 0x46 &&
					bytes[payload + 4] === 0;
				if (isJfif) {
					bytes[payload + 7] = 1;
					bytes[payload + 8] = (density >> 8) & 0xff;
					bytes[payload + 9] = density & 0xff;
					bytes[payload + 10] = (density >> 8) & 0xff;
					bytes[payload + 11] = density & 0xff;
					return new Blob([bytes], { type: "image/jpeg" });
				}
				offset += segmentLength;
			}

			const app0 = new Uint8Array([
				0xff,
				0xe0,
				0x00,
				0x10,
				0x4a,
				0x46,
				0x49,
				0x46,
				0x00,
				0x01,
				0x01,
				0x01,
				(density >> 8) & 0xff,
				density & 0xff,
				(density >> 8) & 0xff,
				density & 0xff,
				0x00,
				0x00,
			]);
			const result = new Uint8Array(bytes.length + app0.length);
			result.set(bytes.subarray(0, 2));
			result.set(app0, 2);
			result.set(bytes.subarray(2), app0.length + 2);
			return new Blob([result], { type: "image/jpeg" });
		}

		async function exportImage() {
			if (!image || !cropRect) {
				window.alert("Choose an image before downloading.");
				return;
			}
			const output = dimensions();
			if (!output) {
				window.alert(
					"Enter valid dimensions that produce an output of 3000 px or less per side.",
				);
				return;
			}
			downloadButton.disabled = true;
			try {
				let blob = await addJfifDensity(
					await getBlob(0.92),
					output.dpi,
				);
				if (maxFileSizeKb > 0) {
					let low = 0.1;
					let high = 0.92;
					for (
						let attempt = 0;
						attempt < 10 && blob.size >= maxFileSizeKb * 1024;
						attempt += 1
					) {
						const quality = (low + high) / 2;
						const candidate = await addJfifDensity(
							await getBlob(quality),
							output.dpi,
						);
						if (candidate.size >= maxFileSizeKb * 1024)
							high = quality;
						else {
							low = quality;
							blob = candidate;
						}
					}
					if (blob.size >= maxFileSizeKb * 1024) {
						blob = await addJfifDensity(
							await getBlob(low),
							output.dpi,
						);
					}
					if (blob.size >= maxFileSizeKb * 1024) {
						window.alert(
							`This image cannot be compressed to under ${maxFileSizeKb} KB at the required dimensions. Try a simpler image.`,
						);
						return;
					}
				}

				const objectUrl = URL.createObjectURL(blob);
				const anchor = document.createElement("a");
				const safeName = filenameInput.value
					.trim()
					.replace(/[\\/:*?"<>|]/g, "-");
				anchor.href = objectUrl;
				anchor.download = safeName
					? /\.(jpe?g)$/i.test(safeName)
						? safeName
						: `${safeName}.jpeg`
					: `pan-${mode}.jpeg`;
				document.body.append(anchor);
				anchor.click();
				anchor.remove();
				window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
			} catch (error) {
				window.alert(
					error instanceof Error
						? error.message
						: "The image could not be exported. Try again.",
				);
			} finally {
				downloadButton.disabled = !image;
			}
		}

		modeButtons.forEach((button) =>
			button.addEventListener("click", () => {
				const nextMode = button.dataset.mode;
				if (nextMode === "photo" || nextMode === "signature")
					setMode(nextMode);
			}),
		);
		portalPresetInput.addEventListener("change", () => setMode(mode));
		fileInput.addEventListener("change", (event) => {
			if (event.currentTarget instanceof HTMLInputElement)
				loadFile(event.currentTarget.files?.[0]);
		});
		dropZone.addEventListener("click", (event) => {
			if (image) return;
			if (
				event.target instanceof Element &&
				event.target.closest(".crop-stage")
			)
				return;
			fileInput.click();
		});
		dropZone.addEventListener("dragover", (event) => {
			event.preventDefault();
			dropZone.classList.add("is-dragging");
		});
		dropZone.addEventListener("dragleave", (event) => {
			if (
				!(event.relatedTarget instanceof Node) ||
				!dropZone.contains(event.relatedTarget)
			) {
				dropZone.classList.remove("is-dragging");
			}
		});
		dropZone.addEventListener("drop", (event) => {
			event.preventDefault();
			dropZone.classList.remove("is-dragging");
			if (!event.dataTransfer) return;
			loadFile(event.dataTransfer.files?.[0]);
		});
		[dpiInput, widthInput, heightInput].forEach((input) =>
			input.addEventListener("input", updateDimensions),
		);
		window.addEventListener("resize", updateCropSelection);
		downloadButton.addEventListener("click", exportImage);
		removeButton.addEventListener("click", resetImage);

		cropStage.addEventListener("pointerdown", (event) => {
			if (
				!image ||
				!cropRect ||
				!(event.target instanceof Element) ||
				!event.target.closest(".crop-selection")
			)
				return;
			const bounds = canvas.getBoundingClientRect();
			if (!bounds.width || !bounds.height) return;
			const corner =
				event.target
					.closest("[data-corner]")
					?.getAttribute("data-corner") ?? null;
			dragState = {
				pointerId: event.pointerId,
				startX:
					((event.clientX - bounds.left) / bounds.width) *
					image.naturalWidth,
				startY:
					((event.clientY - bounds.top) / bounds.height) *
					image.naturalHeight,
				initialCrop: { ...cropRect },
				corner,
			};
			cropStage.setPointerCapture(event.pointerId);
			cropSelection.focus({ preventScroll: true });
			event.preventDefault();
		});
		cropStage.addEventListener("pointermove", (event) => {
			if (!image || !dragState || dragState.pointerId !== event.pointerId)
				return;
			const bounds = canvas.getBoundingClientRect();
			if (!bounds.width || !bounds.height) return;
			const pointerX =
				((event.clientX - bounds.left) / bounds.width) *
				image.naturalWidth;
			const pointerY =
				((event.clientY - bounds.top) / bounds.height) *
				image.naturalHeight;
			const deltaX = pointerX - dragState.startX;
			const deltaY = pointerY - dragState.startY;
			const initial = dragState.initialCrop;
			if (!dragState.corner) {
				cropRect = {
					...initial,
					x: Math.max(
						0,
						Math.min(
							image.naturalWidth - initial.width,
							initial.x + deltaX,
						),
					),
					y: Math.max(
						0,
						Math.min(
							image.naturalHeight - initial.height,
							initial.y + deltaY,
						),
					),
				};
			} else {
				const directionX = dragState.corner.includes("w") ? -1 : 1;
				const directionY = dragState.corner.includes("n") ? -1 : 1;
				const anchorX =
					directionX < 0 ? initial.x + initial.width : initial.x;
				const anchorY =
					directionY < 0 ? initial.y + initial.height : initial.y;
				const maxWidth = Math.min(
					directionX < 0 ? anchorX : image.naturalWidth - anchorX,
					(directionY < 0 ? anchorY : image.naturalHeight - anchorY) *
						cropRatio,
				);
				const minWidth = Math.min(32, maxWidth);
				const width = Math.min(
					maxWidth,
					Math.max(
						minWidth,
						Math.max(
							Math.abs(pointerX - anchorX),
							Math.abs(pointerY - anchorY) * cropRatio,
						),
					),
				);
				const height = width / cropRatio;
				cropRect = {
					x: directionX < 0 ? anchorX - width : anchorX,
					y: directionY < 0 ? anchorY - height : anchorY,
					width,
					height,
				};
			}
			drawPreview();
		});
		cropStage.addEventListener("pointerup", (event) => {
			if (dragState?.pointerId === event.pointerId) dragState = null;
		});
		cropStage.addEventListener("pointercancel", (event) => {
			if (dragState?.pointerId === event.pointerId) dragState = null;
		});
		cropSelection.addEventListener("keydown", (event) => {
			if (!image || !cropRect) return;
			const step =
				Math.min(image.naturalWidth, image.naturalHeight) *
				(event.shiftKey ? 0.05 : 0.01);
			if (event.key === "ArrowLeft")
				cropRect.x = Math.max(0, cropRect.x - step);
			else if (event.key === "ArrowRight")
				cropRect.x = Math.min(
					image.naturalWidth - cropRect.width,
					cropRect.x + step,
				);
			else if (event.key === "ArrowUp")
				cropRect.y = Math.max(0, cropRect.y - step);
			else if (event.key === "ArrowDown")
				cropRect.y = Math.min(
					image.naturalHeight - cropRect.height,
					cropRect.y + step,
				);
			else return;
			event.preventDefault();
			drawPreview();
		});

		setMode("photo");
	</script>
</Layout>
