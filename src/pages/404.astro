---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Layout
	title="Page Not Found | NSDL Photo Resize"
	description="The page you are looking for could not be found."
	canonicalUrl={null}
	noindex
>
	<div class="flex min-h-screen flex-col bg-page text-ink">
		<SiteHeader />
		<main class="hero-wash flex flex-1 items-center px-5 py-20 sm:px-8">
			<div class="mx-auto w-full max-w-3xl">
				<p class="eyebrow mb-3">Error 404</p>
				<h1 class="max-w-3xl text-4xl font-semibold leading-tight tracking-[-0.045em] sm:text-5xl">
					This page doesn't exist.
				</h1>
				<p class="mt-5 max-w-2xl text-base leading-7 text-body sm:text-lg">
					The link may be incorrect, or the page may have moved. You can head
					back to the PAN photo resizer or browse the help pages.
				</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a class="button-primary" href="/">Go to homepage</a>
					<a class="button-secondary" href="/how-it-works/">How it works</a>
				</div>
			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>
