<header class="border-b border-hairline">
	<nav
		class="mx-auto flex min-h-16 flex-wrap items-center justify-between gap-y-3 px-5 py-3 sm:px-8"
		aria-label="Main navigation"
	>
		<a
			class="flex items-center gap-2.5 font-semibold tracking-tight"
			href="/"
			aria-label="NSDL Photo Resize home"
		>
			<img src="/src/assets/logo.svg" height="44px" width="44px" alt="PAN card resizer logo">
			<span>NSDL Photo Resize</span>
		</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-navigation"
			aria-label="Open navigation menu"
		>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M4 7h16M4 12h16M4 17h16"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"></path>
			</svg>
		</button>
		<div id="site-navigation" class="site-navigation">
			<div class="site-navigation-links">
				<a class="transition hover:text-ink" href="/">Home</a>
				<a class="transition hover:text-ink" href="/about/">About</a>
				<a class="transition hover:text-ink" href="/features/"
					>Features</a
				>
				<a class="transition hover:text-ink" href="/how-it-works/"
					>How it works</a
				>
				<a class="transition hover:text-ink" href="/faq/">FAQ</a>
				<a class="transition hover:text-ink" href="/contact-us/"
					>Contact Us</a
				>
			</div>
			<div class="site-navigation-actions">
				<button
					id="theme-toggle"
					class="theme-toggle"
					type="button"
					aria-label="Switch to dark mode"
					aria-pressed="false"
					title="Switch to dark mode"
				>
					<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
					<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"></circle>
						<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
					</svg>
				</button>
				<a class="button-primary h-10! px-4!" href="/#photo-tool"
					>Resize a photo</a
				>
			</div>
		</div>
	</nav>
</header>

<style>
	.site-navigation {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.site-navigation-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		font-size: 0.875rem;
		color: var(--color-body);
	}

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--color-hairline);
		border-radius: 0.5rem;
		background: var(--color-surface);
		color: var(--color-ink);
	}

	.site-navigation-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.theme-toggle {
		display: inline-grid;
		width: 2.5rem;
		height: 2.5rem;
		place-items: center;
		border: 1px solid var(--color-hairline-strong);
		border-radius: 0.5rem;
		background: var(--color-surface);
		color: var(--color-ink);
		cursor: pointer;
		transition: background-color 150ms ease, border-color 150ms ease;
	}

	.theme-toggle:hover {
		background: var(--color-surface-soft);
	}

	.theme-icon {
		width: 1.2rem;
		height: 1.2rem;
	}

	html[data-theme="dark"] .theme-icon-moon,
	html:not([data-theme="dark"]) .theme-icon-sun {
		display: none;
	}

	.menu-toggle svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	@media (max-width: 767px), (orientation: portrait) and (max-width: 1024px) {
		.menu-toggle {
			display: inline-flex;
		}

		.site-navigation {
			display: none;
			width: 100%;
			align-items: stretch;
			flex-direction: column;
			padding: 0.5rem 0 0.25rem;
		}

		.site-navigation.is-open {
			display: flex;
		}

		.site-navigation-links {
			align-items: stretch;
			flex-direction: column;
			gap: 0;
			font-size: 1rem;
		}

		.site-navigation-links a {
			padding: 0.75rem 0;
		}

		.site-navigation-actions {
			align-self: flex-start;
		}
	}

		@media (min-width: 1024px) and (orientation: landscape), (min-width: 1025px) {
			header nav {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				column-gap: 1.25rem;
				flex-wrap: nowrap;
			}

			.site-navigation {
				display: contents;
			}

			.site-navigation-links {
				grid-column: 2;
				grid-row: 1;
			}

			.site-navigation-actions {
				grid-column: 3;
				grid-row: 1;
				justify-self: end;
			}
		}
</style>

<script>
	const menuToggle =
		document.querySelector<HTMLButtonElement>(".menu-toggle");
	const siteNavigation =
		document.querySelector<HTMLDivElement>("#site-navigation");
	const themeToggle =
		document.querySelector<HTMLButtonElement>("#theme-toggle");

	function updateThemeToggle() {
		const isDark = document.documentElement.dataset.theme === "dark";
		const label = isDark ? "Switch to light mode" : "Switch to dark mode";
		themeToggle?.setAttribute("aria-label", label);
		themeToggle?.setAttribute("title", label);
		themeToggle?.setAttribute("aria-pressed", String(isDark));
	}

	function setTheme(theme: "light" | "dark") {
		document.documentElement.dataset.theme = theme;
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute("content", theme === "dark" ? "#111315" : "#ffffff");
		updateThemeToggle();
	}

	updateThemeToggle();
	themeToggle?.addEventListener("click", () => {
		const nextTheme =
			document.documentElement.dataset.theme === "dark" ? "light" : "dark";
		setTheme(nextTheme);
		try {
			localStorage.setItem("nsdl-photo-resize-theme", nextTheme);
		} catch (error) {
			console.error("Unable to save the theme preference.", error);
		}
	});

	window
		.matchMedia("(prefers-color-scheme: dark)")
		.addEventListener("change", updateThemeToggle);

	menuToggle?.addEventListener("click", () => {
		if (!siteNavigation) return;

		const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
		menuToggle.setAttribute("aria-expanded", String(!isExpanded));
		menuToggle.setAttribute(
			"aria-label",
			isExpanded ? "Open navigation menu" : "Close navigation menu",
		);
		siteNavigation.classList.toggle("is-open", !isExpanded);
	});

	siteNavigation?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menuToggle?.setAttribute("aria-expanded", "false");
			menuToggle?.setAttribute("aria-label", "Open navigation menu");
			siteNavigation.classList.remove("is-open");
		});
	});
</script>
