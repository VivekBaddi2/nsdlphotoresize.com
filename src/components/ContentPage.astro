---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
	title: string;
	description: string;
	canonicalUrl: string;
	eyebrow: string;
	heading: string;
	intro: string;
}

const { title, description, canonicalUrl, eyebrow, heading, intro } =
	Astro.props;
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
	<div class="min-h-screen bg-page text-ink">
		<SiteHeader />
		<main>
			<section class="hero-wash px-5 py-14 sm:px-8 sm:py-18">
				<div class="mx-auto max-w-3xl">
					<p class="eyebrow mb-3">{eyebrow}</p>
					<h1
						class="max-w-3xl text-4xl font-semibold leading-tight tracking-[-0.045em] sm:text-5xl"
					>
						{heading}
					</h1>
					<p class="mt-5 max-w-2xl text-base leading-7 text-body sm:text-lg">
						{intro}
					</p>
					<a class="button-primary mt-7" href="/#photo-tool">
						Open the PAN photo resizer
					</a>
				</div>
			</section>
			<div class="mx-auto max-w-3xl space-y-8 px-5 py-12 leading-7 text-body sm:px-8 sm:py-16">
				<slot />
			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>
