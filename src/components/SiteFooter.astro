---
import logo from "../assets/logo.svg";

const badges = [
	{
		href: "https://launchnest.io/p/nsdl-photo-resize-pan-card-photo-resizer",
		src: "https://launchnest.io/badge/nsdl-photo-resize-pan-card-photo-resizer.svg?variant=featured",
		alt: "NSDL Photo Resize - PAN card photo resizer on LaunchNest",
		width: 220,
		height: 56,
	},
	{
		href: "https://www.producthunt.com/products/nsdl-photo-resize/reviews/new?utm_source=badge-product_review&utm_medium=badge&utm_source=badge-nsdl-photo-resize",
		src: "https://api.producthunt.com/widgets/embed-image/v1/product_review.svg?product_id=1361125&theme=light",
		alt: "NSDL Photo Resize - PAN Card Photo Resizer Online | Product Hunt",
		width: 250,
		height: 54,
	},
	{
		href: "https://launch-list.org/product/nsdl-photo-resize-pan-card-photo-and-signature-resizer",
		src: "https://launch-list.org/badges/svg/launch_list_badge_live.svg",
		alt: "Launch List Badge",
		height: 50,
	},
	{
		href: "https://www.codehype.ai/product/nsdl-photo-resize?utm_source=codehype_badge",
		src: "https://www.codehype.ai/badges/nsdl-photo-resize.svg?variant=find-us&v=20",
		alt: "Featured on CodeHype",
		width: 180,
		height: 65,
		loading: "lazy" as const,
		decoding: "async" as const,
		style: "display:inline-block;border:0;width:100%;max-width:180px;height:auto;max-height:65px;",
	},
	{
		href: "https://huzzler.so/products/qrRF9v26w1/nsdl-photo-resize-pan-card-photo-resizer?utm_source=huzzler_product_website&utm_medium=badge&utm_campaign=free_listing",
		src: "https://huzzler.so/assets/images/embeddable-badges/featured.png",
		alt: "Huzzler Embed Badge",
		width: 159,
		height: 55,
	},
];
---

<footer class="border-t border-hairline bg-surface-soft px-5 sm:px-8">
	<div class="mx-auto max-w-6xl">
		<div class="badge-marquee pt-8" role="group" aria-label="Featured on">
			<div class="badge-marquee-track">
				{
					[0, 1].map((copy) => (
						<div
							class="badge-marquee-group"
							aria-hidden={copy === 1 ? "true" : undefined}
							inert={copy === 1}
						>
							{badges.map(({ href, ...image }) => (
								<a
									class="block shrink-0"
									href={href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<img {...image} />
								</a>
							))}
						</div>
					))
				}
			</div>
		</div>

		<div
			class="grid grid-cols-2 gap-x-8 gap-y-10 py-12 sm:gap-x-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-12 lg:py-14"
		>
			<div class="col-span-2 max-w-xs space-y-3 lg:col-span-1">
				<a
					class="inline-flex items-center gap-2.5 font-semibold tracking-tight text-ink"
					href="/"
				>
					<img src={logo.src} width="36" height="36" alt="" />
					NSDL Photo Resize
				</a>
				<p class="text-sm leading-6 text-body">
					Use this PAN card photo resizer to crop and resize photos
					and signatures for PAN applications. Adjust dimensions and
					download a JPEG; your images stay in your browser.
				</p>
			</div>

			<nav aria-label="Footer navigation">
				<h2
					class="mb-4 text-xs font-medium uppercase tracking-wider text-muted"
				>
					Navigation
				</h2>
				<ul class="space-y-3 text-sm">
					<li>
						<a class="text-body transition hover:text-ink" href="/"
							>Home</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/about/">About</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/features/">Features</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/how-it-works/">How it works</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/faq/">FAQ</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/blogs/">Blogs</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/contact-us/">Contact Us</a>
					</li>
				</ul>
			</nav>

			<nav aria-label="Legal">
				<h2
					class="mb-4 text-xs font-medium uppercase tracking-wider text-muted"
				>
					Legal
				</h2>
				<ul class="space-y-3 text-sm">
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/privacy-policy/">Privacy Policy</a>
					</li>
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/terms-of-service/">Terms of Service</a>
					</li>
				</ul>
			</nav>

			<nav aria-label="Tools">
				<h2
					class="mb-4 text-xs font-medium uppercase tracking-wider text-muted"
				>
					Tool
				</h2>
				<ul class="space-y-3 text-sm">
					<li>
						<a
							class="text-body transition hover:text-ink"
							href="/#photo-tool">PAN Photo Resizer</a>
					</li>
				</ul>
			</nav>
		</div>

		<div
			class="flex flex-col gap-2 border-t border-hairline py-5 text-xs leading-5 text-muted sm:flex-row sm:items-center sm:justify-between"
		>
			<p>
				© {new Date().getFullYear()} NSDL Photo Resize. All rights reserved.
			</p>
			<p>
				Independent tool. Not affiliated with Protean, NSDL, or UTIITSL.
			</p>
		</div>
	</div>
</footer>

<style>
	.badge-marquee {
		overflow: hidden;
	}

	.badge-marquee-track {
		display: flex;
		width: max-content;
		animation: badge-marquee-scroll 32s linear infinite;
	}

	.badge-marquee-group {
		display: flex;
		flex: none;
		align-items: center;
		gap: 1rem;
		padding-right: 1rem;
	}

	.badge-marquee:hover .badge-marquee-track,
	.badge-marquee:focus-within .badge-marquee-track {
		animation-play-state: paused;
	}

	@keyframes badge-marquee-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.badge-marquee-track {
			width: auto;
			animation: none;
		}

		.badge-marquee-group:first-child {
			flex-wrap: wrap;
			justify-content: center;
			padding-right: 0;
		}

		.badge-marquee-group:last-child {
			display: none;
		}
	}
</style>
